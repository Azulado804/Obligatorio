@page
@model Obligatorio.Pages.PageEquipamiento.ListarModel

@{
    ViewData["Title"] = "Listar Equipamiento";
}

<h2>Lista de Equipamientos</h2>

<table border="1">
    <thead>
        <tr>
            <th>Id</th>
            <th>Nombre</th>
            <th>Descripción</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Lista != null)
        {
            @foreach (var item in Model.Lista)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.Nombre</td>
                    <td>@item.Descripcion</td>
                    <td>
                        <a class="btn btn-primary" asp-page="./Modificar" asp-route-id="@item.Id">
                            <i class="fa fa-edit" aria-hidden="true"></i>
                        </a>
                        <a class="btn btn-danger" asp-page="./Eliminar" asp-route-id="@item.Id">
                            <i class="fa fa-trash" aria-hidden="true"></i>
                        </a>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

<br />
<a asp-page="/PageEquipamento/Alta">Nuevo</a>
