@page
@model Obligatorio.Pages.PageEquipamiento.ModificarModel
@{
    ViewData["Title"] = "Modificar Equipamiento";
}
<div class="text-left">
    <h1 class="display-4 text-center">Modificar un Equipamiento</h1>
    <hr />
    @if (Model.equipamiento is not null)
    {
        <form method="post">
            <div class="row">
                <div class="col-sm-4">
                    <div class="form-group">
                        <label for="id">ID:</label>
                        <input class="form-control" type="text" name="id" id="id" value="@Model.equipamiento.Id" readonly />
                    </div>
                    <div class="form-group">
                        <label for="nombre">Nombre:</label>
                        <input class="form-control" type="text" name="nombre" id="nombre" value="@Model.equipamiento.Nombre" />
                    </div>
                    <div class="form-group">
                        <label for="descripcion">Descripción:</label>
                        <input class="form-control" type="text" name="descripcion" id="descripcion" value="@Model.equipamiento.Descripcion" />
                    </div>
                </div>
            </div>
            <hr />
            <div class="row">
                <div class="mt-2">
                    <button class="btn btn-success" type="submit" asp-page-handler="Modificar">Modificar</button>
                    <a class="btn btn-warning" asp-page="./Listar">Volver</a>
                </div>
            </div>
        </form>
    }
    else if (Model.Lista.Count > 0)
    {
        <form method="get">
            <label for="id">Seleccione el equipamiento que desea modificar:</label>
            <select class="form-select" name="id" id="id">
                @foreach (var item in Model.Lista)
                {
                    <option value="@item.Id">@item.Nombre</option>
                }
            </select>
            <button class="btn btn-primary mt-2" type="submit">Continuar</button>
        </form>
    }
    else
    {
        <p>No hay equipamientos para modificar.</p>
    }

    @if (!string.IsNullOrEmpty(Model.Mensaje))
    {
        <br />
        <div class="alert alert-danger" role="alert">
            @Model.Mensaje
        </div>
    }
</div>
